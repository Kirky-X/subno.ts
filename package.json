{
  "name": "subno.ts",
  "version": "0.2.2",
  "description": "加密推送通知服务 - SecureNotify",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "vercel-build": "next build",
    "db:migrate": "node scripts/run-migrations.js",
    "db:migrate:revocation": "node scripts/migrate-revocation.js",
    "db:migrate:revocation:rollback": "node scripts/migrate-revocation.js rollback",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "dep:check": "node scripts/dependency-check.js",
    "dep:audit": "npm audit",
    "dep:fix": "npm audit fix",
    "security:check-exports": "node scripts/check-module-exports.js",
    "security:audit": "npm run security:check-exports && echo '✅ 安全审计完成'",
    "license:update": "node scripts/update-license-year.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "async-retry": "^1.3.3",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.1",
    "lru-cache": "^11.5.2",
    "mitt": "^3.0.1",
    "next": "^16.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.16"
  }
}
