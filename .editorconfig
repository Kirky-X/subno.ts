# EditorConfig — 跨编辑器/IDE 维持一致的缩进、换行、字符集。
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Markdown 保留尾随空格（两个空格表示换行）
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefile 必须用 Tab
[Makefile]
indent_style = tab

# YAML
[*.{yml,yaml}]
indent_size = 2

# Shell
[*.sh]
indent_size = 4

# Husky hooks 需保持可执行 shebang
[.husky/*]
indent_size = 4
